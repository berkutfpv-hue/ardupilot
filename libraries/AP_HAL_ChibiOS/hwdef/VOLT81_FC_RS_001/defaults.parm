# Analog OSD
OSD_TYPE 1
OSD1_ENABLE 1
OSD_FONT 0
OSD_V_FORMAT 0
OSD_CELL_COUNT 12

# Battery 12S
BATT_MONITOR 4
BATT_VOLT_MULT 22.29
BATT_AMP_PERVLT 71.43
BATT_CRT_VOLT 39.6
BATT_LOW_VOLT 42.0

# DShot600 on M1-M4
MOT_PWM_TYPE 6

# Ports: SERIAL4=VTX (IRC Tramp), SERIAL7=ELRS (CRSF)
SERIAL4_PROTOCOL 37
VTX_ENABLE 1
SERIAL7_PROTOCOL 23

# Stick mapping TAER and Arming
RCMAP_THROTTLE 1
RCMAP_ROLL 2
RCMAP_PITCH 3
RCMAP_YAW 4
RC5_OPTION 153
FLTMODE_CH 6
FLTMODE1 0
FLTMODE2 2
FLTMODE3 1

# Camera / Power switches
RELAY1_PIN 81
RELAY1_FUNCTION 1
RELAY1_DEFAULT 0
RELAY2_PIN 82
RELAY2_FUNCTION 1
RELAY2_DEFAULT 1

# Disable compass if not connected externally
COMPASS_USE 0
