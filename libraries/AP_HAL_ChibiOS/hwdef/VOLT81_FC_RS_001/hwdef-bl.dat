# Bootloader hardware definition for VOLT81_FC_RS_001 (VOLT3TB)
MCU STM32H7xx STM32H743xx

APJ_BOARD_ID AP_HW_MATEKH743
define HAL_BOARD_NAME "RS_H743_by VOLT"
USB_STRING_MANUFACTURER "VOLT3TB"
USB_STRING_PRODUCT "RS_H743_VOLT_BL"
USB_PID 0x574A

OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_BOOTLOADER_LOAD_KB 128

STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

PE5 LED0 OUTPUT LOW GPIO(90)
PE4 LED1 OUTPUT LOW GPIO(91)
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90

# Keep power switches in safe default state during boot
PE10 PINIO1 OUTPUT GPIO(81) LOW
PB5  PINIO2 OUTPUT GPIO(82) HIGH
