# hw definition file for FH7-12S V1.0 / TBF81_FC_RS_001H743_V1
MCU STM32H7xx STM32H743xx

# Keep MatekH743 board ID for direct .apj flashing via Mission Planner
APJ_BOARD_ID AP_HW_MATEKH743
define HAL_BOARD_NAME "FC_RS_001H743_by VOLT"
USB_STRING_MANUFACTURER "VOLT3TB"
USB_STRING_PRODUCT "FC_RSH743_VOLT"
USB_PID 0x5749

OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128

STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# USB OTG
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# SPI1 - IMU 1 (ICM-42688-P, CW0, MOSI on PD7 + EXTI on PE9)
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PD7 SPI1_MOSI SPI1
PA4 IMU1_CS CS

# SPI2 - Analog OSD MAX7456 / AT7456E
PB12 MAX7456_CS CS
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2

# SPI3 - Unused on this board (PB5 freed for PINIO2)
#PB3 SPI3_SCK SPI3
#PB4 SPI3_MISO SPI3
#PB5 SPI3_MOSI SPI3
#PD4 EXT_CS1 CS
#PE2 EXT_CS2 CS

# SPI4 - IMU 2 (ICM-42688-P, CW270 + EXTI on PE15)
PE11 IMU2_CS CS
PE12 SPI4_SCK SPI4
PE13 SPI4_MISO SPI4
PE14 SPI4_MOSI SPI4

# I2C buses (I2C4 = internal baro DPS310, I2C2 = external compass)
I2C_ORDER I2C4 I2C2

PD12 I2C4_SCL I2C4
PD13 I2C4_SDA I2C4

PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

# ADC and 12S battery divider (PC1 = pin 11, PC3 = pin 13)
PC1 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC3 BATT_CURRENT_SENS ADC1 SCALE(1)
PA7 BATT2_CURRENT_SENS ADC1 SCALE(1)

define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 11
define HAL_BATT_CURR_PIN 13
define HAL_BATT2_CURR_PIN 7
define HAL_BATT_VOLT_SCALE 22.0
define HAL_BATT_CURR_SCALE 71.43

PC4 PRESSURE_SENS ADC1 SCALE(2)
define HAL_DEFAULT_AIRSPEED_PIN 4
PC5 RSSI_ADC ADC1
define BOARD_RSSI_ANA_PIN 8

# Status LEDs
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
PE3 LED0 OUTPUT LOW GPIO(90)
PE4 LED1 OUTPUT LOW GPIO(91)
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90

# Direct UART mapping: SERIAL1=UART1 ... SERIAL4=UART4(VTX) ... SERIAL7=UART7(ELRS)
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 EMPTY USART6 UART7 UART8

# SERIAL1 (UART1)
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# SERIAL2 (UART2 - Jetson / Orange Pi / VIO / Companion Computer)
PD5 USART2_TX USART2
PD6 USART2_RX USART2

# SERIAL3 (UART3 - GPS / SIYI)
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# SERIAL4 (UART4 - Analog VTX IRC Tramp on TX4/RX4)
PD1 UART4_TX UART4
PD0 UART4_RX UART4

# SERIAL6 (USART6 - GPS2 / UART Lidar)
PC6 USART6_TX USART6 NODMA
PC7 USART6_RX USART6 NODMA

# SERIAL7 (UART7 - ELRS / CRSF receiver on RX7/TX7)
PE8 UART7_TX UART7
PE7 UART7_RX UART7

# SERIAL8 (UART8 - Digital HD MSP / 2nd SBUS receiver)
PE1 UART8_TX UART8
PE0 UART8_RX UART8

# Motors 1-4 (Native TIM2 with exclusive DMA for DShot600)
PA0 TIM2_CH1 TIM2 PWM(1) GPIO(50)
PA1 TIM2_CH2 TIM2 PWM(2) GPIO(51)
PA2 TIM2_CH3 TIM2 PWM(3) GPIO(52)
PA3 TIM2_CH4 TIM2 PWM(4) GPIO(53)

# Motors 5-6 and Servo outputs 9-13 (NODMA to preserve DMA for TIM2)
PB0  TIM1_CH2N TIM1 PWM(5) GPIO(54) NODMA
PB1  TIM1_CH3N TIM1 PWM(6) GPIO(55) NODMA
PD14 TIM4_CH3 TIM4 PWM(9) GPIO(58) NODMA
PD15 TIM4_CH4 TIM4 PWM(10) GPIO(59) NODMA
PE5  TIM15_CH1 TIM15 PWM(11) GPIO(60) NODMA
PE6  TIM15_CH2 TIM15 PWM(12) GPIO(61) NODMA
PA8  TIM1_CH1 TIM1 PWM(13) GPIO(62) NODMA

# Buzzer (PB7)
PB7 TIM4_CH2 TIM4 GPIO(32) ALARM

# microSD card (SDIO 4-bit + FatFS support)
PC8  SDMMC1_D0 SDMMC1
PC9  SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2  SDMMC1_CMD SDMMC1
STM32_SDC_USE_SDMMC1 TRUE
define HAL_OS_FATFS_IO 1
define STM32_SDC_SDMMC_CLOCK 25000000
define HAL_BOARD_LOG_DIRECTORY "/APM/LOGS"
define HAL_BOARD_TERRAIN_DIRECTORY "/APM/TERRAIN"

# Power switches and Camera C1/C2 switch (PE10 = CAM2, PB5 = OSD/VTX power)
PE10 PINIO1 OUTPUT GPIO(81) HIGH
PB5  PINIO2 OUTPUT GPIO(82) HIGH

# Top DMA priority and exclusive allocation for TIM2
DMA_PRIORITY TIM2* SPI1* SPI4* ADC*
DMA_NOSHARE SPI1* SPI4*

define HAL_STORAGE_SIZE 32768
STORAGE_FLASH_PAGE 14

# SPI sensor devices (AT7456E OSD at 2MHz for reliable init)

SPIDEV icm42688   SPI1 DEVID1 IMU1_CS    MODE3  2*MHZ 16*MHZ
SPIDEV icm42688_2 SPI4 DEVID1 IMU2_CS    MODE3  2*MHZ 16*MHZ
SPIDEV osd        SPI2 DEVID1 MAX7456_CS MODE0  4*MHZ  4*MHZ
#SPIDEV pixartflow SPI3 DEVID1 EXT_CS1    MODE3  2*MHZ  2*MHZ

# External compass and barometer probing
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 1
define HAL_COMPASS_AUTO_ROT_DEFAULT 2
BARO DPS310 I2C:0:0x76
BARO DPS310 I2C:0:0x77
BARO BMP280 I2C:0:0x76
BARO SPL06  I2C:0:0x76

# Dual ICM-42688-P IMUs
IMU Invensensev3 SPI:icm42688 ROTATION_NONE
IMU Invensensev3 SPI:icm42688_2 ROTATION_YAW_270

# Analog OSD
define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
